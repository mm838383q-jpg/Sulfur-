/* ЛОПАТА */
let shG={active:false,field:[],meS:0,enS:0,tL:20,timer:null,enT:null};
function startShovel(area){
  if(!gameBet){toast('❌ Ставка');return}
  if(st.money<gameBet){toast('❌ Мало монет');return}
  st.money-=gameBet;save();addP('game_play',1);
  shG.active=true;shG.meS=0;shG.enS=0;shG.tL=20;
  const arr=Array(16).fill(false);for(let i=0;i<8;i++)arr[i]=true;
  for(let i=15;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]]}
  shG.field=arr;
  const mn=st.user?st.user.name:'Ты';
  const en=['Грибник','Копатель','Фермер','Сталкер'][Math.floor(Math.random()*4)];
  area.innerHTML='<div class="gw on"><div class="gt"><div class="pb me"><div class="pa">'+mn.charAt(0).toUpperCase()+'</div><div class="pn">'+mn+'</div><div class="ps" id="meS">0</div></div><div class="tm" id="gameTimer">20</div><div class="pb en"><div class="pa">'+en.charAt(0).toUpperCase()+'</div><div class="pn">'+en+'</div><div class="ps" id="enS">0</div></div></div><div class="fd"><div class="gr" id="gameGrid"></div></div><div class="pp"><div class="pp-l">ПРОГРЕСС ПРОТИВНИКА</div><div class="pp-b"><div class="pp-f" id="oppFill"></div></div></div><button class="bx-b o" style="margin-top:12px" onclick="closeGame()">← Назад</button></div>';
  const g=document.getElementById('gameGrid');
  for(let i=0;i<16;i++){const t=document.createElement('div');t.className='tl';t.onclick=()=>openTile(i,t);g.appendChild(t)}
  const tE=document.getElementById('gameTimer');
  shG.timer=setInterval(()=>{shG.tL--;tE.textContent=shG.tL;if(shG.tL<=5)tE.classList.add('w');if(shG.tL<=0)endSh()},1000);
  shG.enT=setInterval(()=>{
    if(!shG.active)return;
    const cl=[];document.querySelectorAll('#gameGrid .tl').forEach((t,i)=>{if(!t.classList.contains('op'))cl.push(i)});
    if(!cl.length)return;
    const idx=cl[Math.floor(Math.random()*cl.length)];
    const tile=document.querySelectorAll('#gameGrid .tl')[idx];
    tile.classList.add('op');
    if(shG.field[idx]){tile.classList.add('pk');tile.textContent='🎃';shG.enS++;document.getElementById('enS').textContent=shG.enS;document.getElementById('oppFill').style.width=shG.enS/8*100+'%'}
    else{tile.classList.add('em');tile.textContent='·'}
    tile.dataset.en='1';
  },1800);
}
function openTile(i,tile){
  if(!shG.active)return;
  if(tile.classList.contains('op'))return;
  if(tile.dataset.en==='1')return;
  tile.classList.add('op');
  if(shG.field[i]){tile.classList.add('pk');tile.textContent='🎃';shG.meS++;document.getElementById('meS').textContent=shG.meS;beep(700,.1)}
  else{tile.classList.add('em');tile.textContent='·';beep(250,.15)}
}
function endSh(){
  shG.active=false;clearInterval(shG.timer);clearInterval(shG.enT);
  document.querySelectorAll('#gameGrid .tl').forEach((t,idx)=>{if(!t.classList.contains('op')){t.classList.add('op');if(shG.field[idx]){t.classList.add('pk');t.textContent='🎃'}else{t.classList.add('em');t.textContent='·'}}});
  setTimeout(()=>{
    const m=shG.meS,e=shG.enS,b=gameBet;
    if(m>e){st.money+=b*2;toast('🏆 Победа! +'+fmt(b*2));showR('🏆','ПОБЕДА!','+'+fmt(b*2),true);addP('game_win',1)}
    else if(m<e){toast('💥 Проигрыш');showR('💥','ПОРАЖЕНИЕ','-'+fmt(b),false)}
    else{st.money+=b;toast('🤝 Ничья');showR('🤝','НИЧЬЯ','Возврат',null)}
    save();render();
  },700);
}

