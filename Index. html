let rlAngle=0,rlSpinning=false;
function startRoulette(area){
  if(!gameBet){toast('❌ Ставка');return}
  if(st.money<gameBet){toast('❌ Мало монет');return}
  const segments=[
    {mult:0,color:'#5a2e10',label:'x0'},
    {mult:1.5,color:'#6b4f1e',label:'x1.5'},
    {mult:0,color:'#5a2e10',label:'x0'},
    {mult:2,color:'#8a5f18',label:'x2'},
    {mult:0,color:'#5a2e10',label:'x0'},
    {mult:3,color:'#c8912b',label:'x3'},
    {mult:0,color:'#5a2e10',label:'x0'},
    {mult:5,color:'#ff9d3d',label:'x5'},
    {mult:0,color:'#5a2e10',label:'x0'},
    {mult:10,color:'#ffd97a',label:'x10'},
    {mult:0,color:'#5a2e10',label:'x0'},
    {mult:2,color:'#8a5f18',label:'x2'}
  ];
  let segHtml='';
  segments.forEach((s,i)=>{
    const angle=i*30;
    segHtml+='<div class="rl-seg" style="background:'+s.color+';transform:rotate('+angle+'deg);color:'+(s.mult>=5?'#2a1608':'#fff')+';font-weight:900">'+s.label+'</div>';
  });
  area.innerHTML='<div class="sh-h" style="text-align:center"><div class="sh-t">🎡 РУЛЕТКА</div><div style="font-size:11px;color:#ffb347;margin-bottom:6px">Ставка: '+fmt(gameBet)+' 💵</div></div><div class="rl-wrap"><div class="rl-arrow">▼</div><div class="rl-wheel" id="rlWheel">'+segHtml+'</div><div class="rl-center">SPIN</div></div><button class="sp" id="rlBtn" onclick="spinRoulette()">🎡 КРУТИТЬ</button><button class="bx-b o" style="margin-top:12px" onclick="closeGame()">← Назад</button>';
}
function spinRoulette(){
  if(rlSpinning)return;
  if(st.money<gameBet){toast('❌ Мало монет');return}
  st.money-=gameBet;save();addP('game_play',1);
  rlSpinning=true;
  const segs=[0,1.5,0,2,0,3,0,5,0,10,0,2];
  const winIdx=Math.floor(Math.random()*12);
  const targetAngle=360*8 + (360-(winIdx*30+15));
  rlAngle+=targetAngle;
  const wheel=document.getElementById('rlWheel');
  wheel.style.transform='rotate('+rlAngle+'deg)';
  const tick=setInterval(()=>beep(400,.03),100);
  setTimeout(()=>{
    clearInterval(tick);rlSpinning=false;
    const mult=segs[winIdx];
    if(mult>0){
      const win=Math.round(gameBet*mult);
      st.money+=win;
      toast('🎉 x'+mult+'! +'+fmt(win));
      showR('🎉','ВЫИГРЫШ x'+mult,'+'+fmt(win),true);addP('game_win',1);
      beep(880,.15);setTimeout(()=>beep(1100,.2),150);
    }else{
      toast('💥 Проигрыш');
      showR('💥','ПРОИГРЫШ','-'+fmt(gameBet),false);
      beep(200,.3);
    }
    save();render();
  },5200);
}

