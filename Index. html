let gfState={active:false,giftIdx:-1,lives:3,found:false};
function startGift(area){
  if(!gameBet){toast('❌ Ставка');return}
  if(st.money<gameBet){toast('❌ Мало монет');return}
  st.money-=gameBet;save();addP('game_play',1);
