}
function openGift(i){
  if(!gfState.active)return;
  const tile=document.getElementById('gf'+i);
  if(tile.dataset.opened)return;
  tile.dataset.opened='1';
  if(i===gfState.giftIdx){
    tile.classList.add('pk');tile.textContent='🎁';
    gfState.active=false;gfState.found=true;
    const win=gameBet*3;st.money+=win;
    toast('🎉 Нашёл! +'+fmt(win));
    showR('🎁','НАШЁЛ!','+'+fmt(win),true);addP('game_win',1);
    beep(880,.15);setTimeout(()=>beep(1100,.2),150);setTimeout(()=>beep(1300,.3),300);
    save();render();
  }else{
    tile.classList.add('em');tile.textContent='💨';
    gfState.lives--;
    const l=document.getElementById('gfLives');
    if(l)l.innerHTML='❤️'.repeat(gfState.lives)+'🖤'.repeat(3-gfState.lives);
    beep(200,.2);
    if(gfState.lives<=0){
      gfState.active=false;
      // Открываем где был подарок
      const gt=document.getElementById('gf'+gfState.giftIdx);
      if(gt){gt.classList.add('pk');gt.textContent='🎁'}
      toast('💥 Не нашёл!');
      showR('💥','ПРОИГРЫШ','-'+fmt(gameBet),false);
      save();render();
    }else{
      toast('💨 Мимо! Осталось жизней: '+gfState.lives);
    }
  }
}

/* УГАДАЙ ЧИСЛО */
let ggState={active:false,secret:0,tries:0,maxTries:7,history:[]};
function startGuess(area){
  if(!gameBet){toast('❌ Ставка');return}
  if(st.money<gameBet){toast('❌ Мало монет');return}
  st.money-=gameBet;save();addP('game_play',1);
  ggState={active:true,secret:Math.floor(Math.random()*100)+1,tries:0,maxTries:7,history:[]};
  area.innerHTML='<div class="sh-h" style="text-align:center"><div class="sh-t">🎯 УГАДАЙ ЧИСЛО</div><div style="font-size:11px;color:#ffb347">Ставка: '+fmt(gameBet)+' 💵 · От 1 до 100</div></div><div class="gg-wrap"><div style="font-size:12px;color:#b8825a">Попыток: <span id="ggTries">0</span>/'+ggState.maxTries+'</div><div class="gg-hint" id="ggHint">Введи число</div><input type="number" class="gg-input" id="ggInput" placeholder="1-100" min="1" max="100"><button class="gg-btn" onclick="tryGuess()">ПРОВЕРИТЬ</button><div class="gg-hist" id="ggHist"></div></div><button class="bx-b o" style="margin-top:12px" onclick="closeGame()">← Назад</button>';
}
function tryGuess(){
  if(!ggState.active)return;
  const inp=document.getElementById('ggInput');
  const num=parseInt(inp.value);
  if(!num||num<1||num>100){toast('❌ Введи 1-100');return}
  ggState.tries++;
  document.getElementById('ggTries').textContent=ggState.tries;
  inp.value='';
  const hist=document.getElementById('ggHist');
  if(num===ggState.secret){
    ggState.active=false;
    const mult=Math.max(2,8-ggState.tries);
    const win=gameBet*mult;st.money+=win;
    toast('🎉 Угадал! +'+fmt(win));
    document.getElementById('ggHint').textContent='🎉 ПРАВИЛЬНО: '+num;
    showR('🎯','УГАДАЛ! x'+mult,'+'+fmt(win),true);addP('game_win',1);
    beep(880,.15);setTimeout(()=>beep(1100,.2),150);
    save();render();
    return;
  }
  const hint=num<ggState.secret?'⬆️ Больше':'⬇️ Меньше';
  document.getElementById('ggHint').textContent=hint;
  hist.innerHTML='<div>'+(num<ggState.secret?'📉 '+num+' — загаданное больше':'📈 '+num+' — загаданное меньше')+'</div>'+hist.innerHTML;
  beep(num<ggState.secret?600:400,.1);
  if(ggState.tries>=ggState.maxTries){
    ggState.active=false;
    document.getElementById('ggHint').textContent='💥 Было: '+ggState.secret;
    toast('💥 Не угадал! Было '+ggState.secret);
    showR('💥','ПРОИГРЫШ','-'+fmt(gameBet),false);
    save();render();
  }
}

