function checkSeasonWipe(){
  const now=new Date();
  const w=wk();
  // Первый запуск — сохраняем текущую неделю как стартовую
  if(!st.season){
    st.season=w;
    save();
    return;
  }
  // Если неделя сменилась — ВАЙП
  if(st.season !== w){
    const keepUser = st.user;
    const keepSound = st.sound;
    const keepMusic = st.music;
    st = {
      money:500, inv:[], sound:keepSound, music:keepMusic, sel:-1, tgt:null,
