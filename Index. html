/* ТЕХ.РАБОТЫ 20:00-20:21 */
const MS=20*60,ME=20*60+21;
function isMt(){const d=new Date(),t=d.getHours()*60+d.getMinutes();return t>=MS&&t<ME}
function ckMt(){if(isMt()){document.getElementById('maint').classList.add('on');upMt()}else{document.getElementById('maint').classList.remove('on')}}
function upMt(){const d=new Date(),t=d.getHours()*60+d.getMinutes();const df=ME-t,mm=Math.max(0,Math.floor(df)),ss=59-d.getSeconds();document.getElementById('maintTimer').textContent=String(mm).padStart(2,'0')+':'+String(ss).padStart(2,'0');document.getElementById('maintFill').style.width=Math.min(100,(t-MS)/(ME-MS)*100)+'%'}
setInterval(()=>{ckMt();if(isMt())upMt()},1000);

