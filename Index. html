function spinUp(){if(st.sel<0||!st.tgt){toast('Выбери предмет и цель!');return}const it=st.inv[st.sel],t=st.tgt;const y=RV[it.rar],tv=RV[t.rar];const c=Math.max(1,Math.min(95,Math.round(y/tv*100)));const dsh=565.5;let cur=0,dir=1;const an=setInterval(()=>{cur+=dir*8;if(cur>=100){cur=100;dir=-1}if(cur<=0){cur=0;dir=1}document.getElementById('upPct').textContent=cur+'%';document.getElementById('upFg').setAttribute('stroke-dashoffset',dsh-dsh*cur/100);const a=-90+360*cur/100,rd=a*Math.PI/180;document.getElementById('upDot').setAttribute('cx',105+90*Math.cos(rd));document.getElementById('upDot').setAttribute('cy',105+90*Math.sin(rd));beep(300+cur*4,.015)},40);setTimeout(()=>{clearInterval(an);document.getElementById('upPct').textContent=c+'%';document.getElementById('upFg').setAttribute('stroke-dashoffset',dsh-dsh*c/100);const w=Math.random()*100<c;st.inv.splice(st.sel,1);st.sel=-1;addP('upgrade',1);if(w){beep(660,.15);setTimeout(()=>beep(880,.15),100);setTimeout(()=>beep(1100,.3),200);st.inv.push({rar:t.rar,icon:t.icon});document.getElementById('dropIcon').textContent=t.icon;document.getElementById('dropName').textContent='Апгрейд!';document.getElementById('dropRar').textContent=RN[t.rar];document.getElementById('dropRar').style.color=RC[t.rar];document.getElementById('dropModal').classList.add('on');addP('upgrade_win',1)}else{beep(200,.3);setTimeout(()=>beep(150,.4),200);document.getElementById('dropIcon').textContent='💥';document.getElementById('dropName').textContent='Провал!';document.getElementById('dropRar').textContent='Потеряно';document.getElementById('dropRar').style.color='#ff5555';document.getElementById('dropModal').classList.add('on')}st.tgt=null;render()},2200)}

